{
  "name": "kit-oratorio-estivo-server",
  "module": "src/index.ts",
  "type": "module",
  "version": "0.0.1",
  "description": "Server API per la comunicazione tra l'interfaccia web ed il database: raccolta iscrizioni, gestione presenze, giochi interattivi e punteggi squadre.",
  "scripts": {
    "start": "NODE_ENV=production bun .",
    "dev": "bun run --hot .",
    "check": "tsc --noEmit --pretty",
    "update-permissions": "bun run scripts/createPermissionFile.ts"
  },
  "keywords": [
    "oratorio",
    "estivo",
    "oratorio",
    "utils-kit"
  ],
  "author": "KappuCitti",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/strftime": "^0.9.8",
    "drizzle-kit": "^0.30.5"
  },
  "peerDependencies": {
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.18.4",
    "@scalar/hono-api-reference": "^0.5.184",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.0",
    "hono": "^4.7.4",
    "hono-pino": "^0.7.2",
    "mysql2": "^3.13.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "strftime": "^0.10.3",
    "toml": "^3.0.0",
    "zod": "^3.24.2"
  }
}
