{
  "name": "kit-oratorio-estivo-server",
  "module": "src/index.ts",
  "type": "module",
  "version": "0.0.1",
  "description": "Server API per la comunicazione tra l'interfaccia web ed il database: raccolta iscrizioni, gestione presenze, giochi interattivi e punteggi squadre.",
  "scripts": {
    "start:ts": "NODE_ENV=production bun .",
    "start": "bun run ./dist/index.js",
    "dev": "bun run --hot .",
    "check": "tsc --noEmit --pretty",
    "build": "tsc -b",
    "db:setup:data": "bun run ./scripts/setupDBData.ts"
  },
  "keywords": [
    "oratorio",
    "estivo",
    "oratorio",
    "utils-kit"
  ],
  "author": "KappuCitti",
  "contributors": [
    "Benjo332"
  ],
  "license": "MIT",
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@types/bun": "latest",
    "@types/strftime": "^0.9.8",
    "drizzle-kit": "^0.30.6"
  },
  "peerDependencies": {
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.18.4",
    "@scalar/hono-api-reference": "^0.5.184",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.1",
    "hono": "^4.7.11",
    "hono-pino": "^0.7.2",
    "mysql2": "^3.14.1",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^3.1.0",
    "strftime": "^0.10.3",
    "toml": "^3.0.0",
    "zod": "^3.25.56"
  }
}
