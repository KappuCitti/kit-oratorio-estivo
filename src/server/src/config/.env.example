# ATTENZIONE: questo file e' tracciato da git. Qui vanno solo valori finti.
# I valori veri stanno in .env, che e' ignorato da git.
#
# I campi booleani accettano solo true/false/1/0: qualunque altro valore fa
# fallire l'avvio (e' voluto, evita che "off" o "no" vengano letti come true).

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
SERVER_ROUTES_PREFIX=/api
SERVER_DOMAIN=localhost
SERVER_FRONTEND_PORT=4200

# HTTPS
SERVER_USE_HTTPS=false
HTTPS_CERT=ssl/cert.pem
HTTPS_KEY=ssl/key.pem

# Logs
# 'debug' scrive su disco dati personali dei ragazzi: usalo solo in locale.
LOG_LEVEL=info
LOG_FOLDER=logs

# Modalita' sviluppo (doc OpenAPI su /api/docs, bypass permessi se abilitato).
# E' opt-in: senza NODE_ENV=development il server parte in modalita' produzione.
# `bun run dev` lo imposta gia' da solo.
# NODE_ENV=development
# DEVELOPMENT_IGNORE_PERMISSIONS=false

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=surelynotyourpassword
DB_DATABASE=oratorio
DB_WAIT_FOR_CONNECTIONS=true
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=3

# Music folder
MUSIC_FOLDER=../public/music